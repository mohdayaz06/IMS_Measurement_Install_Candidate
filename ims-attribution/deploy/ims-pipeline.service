[Unit]
Description=IMS reporting pipeline
After=network-online.target

[Service]
Type=oneshot
User=ims
WorkingDirectory=/opt/ims-attribution
EnvironmentFile=/etc/ims/pipeline.env
ExecStart=/opt/ims-attribution/.venv/bin/python -m integrations.run_pipeline --config /etc/ims/pipeline.json --lock /var/lib/ims/pipeline.lock
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ims
UMask=0077
# Add an OnFailure target for your approved alert transport. No email is sent by this package.
