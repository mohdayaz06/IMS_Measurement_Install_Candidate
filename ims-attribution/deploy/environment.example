# EXAMPLE ONLY. Use /etc/ims/pipeline.env with mode 600, not source control.
# No actual credentials are included. Replace every placeholder before use.
IMS_DB=/var/lib/ims/ims.sqlite3
IMS_IP_HMAC_KEY=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
SHOPIFY_API_VERSION=REPLACE_WITH_SUPPORTED_STABLE_VERSION
SHOPIFY_ADMIN_ACCESS_TOKEN=REPLACE_WITH_MERCHANT_TOKEN
GOOGLE_ADS_API_VERSION=REPLACE_WITH_SUPPORTED_VERSION
GOOGLE_ADS_DEVELOPER_TOKEN=REPLACE_WITH_APPROVED_TOKEN
GOOGLE_ADS_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
GOOGLE_ADS_CLIENT_SECRET=REPLACE_WITH_OAUTH_CLIENT_SECRET
META_API_VERSION=REPLACE_WITH_SUPPORTED_VERSION
IMS_GATEWAYS_FILE=/etc/ims/gateways.json
# Per-client secret ENV names are referenced from examples/pipeline.json.
CLIENT_GOOGLE_ACCOUNT=REPLACE_WITH_CUSTOMER_ID
CLIENT_GOOGLE_REFRESH_TOKEN=REPLACE_WITH_REFRESH_TOKEN
CLIENT_META_ACCOUNT=REPLACE_WITH_ACCOUNT_ID
CLIENT_META_TOKEN=REPLACE_WITH_ACCOUNT_TOKEN
CLIENT_SHOPIFY_TOKEN=REPLACE_WITH_MERCHANT_TOKEN
# Also set each dynamically returned IMS_CONNECTOR_<fingerprint> signing secret
# in the API process environment. Never put this file in a browser/client report.
