// IMS HTTP CLIENT. Importable template generated by build_assets.py.
const getRequestPath=require('getRequestPath');
const getRequestMethod=require('getRequestMethod');
const getRequestHeader=require('getRequestHeader');
const getRequestBody=require('getRequestBody');
const claimRequest=require('claimRequest');
const runContainer=require('runContainer');
const setResponseStatus=require('setResponseStatus');
const setResponseHeader=require('setResponseHeader');
const returnResponse=require('returnResponse');
const JSON=require('JSON');
const path=getRequestPath();
if(path!==data.collectPath && path!==data.verifiedPath)return;
claimRequest();
const method=getRequestMethod();
setResponseHeader('Cache-Control','no-store');
if(path===data.collectPath){
  const origin=getRequestHeader('origin');
  const allowed=data.allowedOrigins.split(',').map(function(s){return s.trim();});
  if(!origin || allowed.indexOf(origin)<0){setResponseStatus(403);returnResponse();return;}
  setResponseHeader('Access-Control-Allow-Origin',origin);
  setResponseHeader('Vary','Origin');
  setResponseHeader('Access-Control-Allow-Methods','POST, OPTIONS');
  setResponseHeader('Access-Control-Allow-Headers','Content-Type');
  if(method==='OPTIONS'){setResponseStatus(204);returnResponse();return;}
}else if(getRequestHeader('x-ims-gateway-key')!==data.gatewayKey){
  setResponseStatus(401);returnResponse();return;
}
if(method!=='POST'){setResponseStatus(405);returnResponse();return;}
const body=JSON.parse(getRequestBody());
if(!body){setResponseStatus(400);returnResponse();return;}
if(path===data.collectPath){
  if(body.analytics_consent!==true || !body.event_id || !body.visitor_id){setResponseStatus(400);returnResponse();return;}
  const event={event_name:'ims_touch',ims_event_id:body.event_id,ims_visitor_id:body.visitor_id,
    ims_ts:body.ts,ims_source:body.source||'direct',ims_medium:body.medium||'',
    ims_campaign:body.campaign||'(none)',ims_order_id:body.order_id||'',
    ims_analytics_consent:1,ims_marketing_consent:body.marketing_consent===true?1:0};
  if(body.marketing_consent===true && body.signals){
    ['gclid','gbraid','wbraid','fbp','fbc'].forEach(function(k){if(body.signals[k])event['ims_'+k]=body.signals[k];});
  }
  runContainer(event,function(){setResponseStatus(202);returnResponse();});
}else{
  if(body.event_name!=='purchase' || body.marketing_consent!==true || !body.transaction_id){setResponseStatus(400);returnResponse();return;}
  runContainer(body,function(){setResponseStatus(202);returnResponse();});
}


